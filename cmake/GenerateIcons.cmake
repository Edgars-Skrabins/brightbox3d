function(bright_icon_utf8 codepoint output)
    math(EXPR first "0xE0 | (${codepoint} >> 12)" OUTPUT_FORMAT HEXADECIMAL)
    math(EXPR second "0x80 | ((${codepoint} >> 6) & 0x3F)" OUTPUT_FORMAT HEXADECIMAL)
    math(EXPR third "0x80 | (${codepoint} & 0x3F)" OUTPUT_FORMAT HEXADECIMAL)
    string(SUBSTRING ${first} 2 -1 first)
    string(SUBSTRING ${second} 2 -1 second)
    string(SUBSTRING ${third} 2 -1 third)
    set(${output} "\"\\x${first}\" \"\\x${second}\" \"\\x${third}\"" PARENT_SCOPE)
endfunction()

function(bright_icon_name kebab output)
    string(REPLACE "-" ";" parts ${kebab})
    set(name "")
    foreach(part ${parts})
        string(SUBSTRING ${part} 0 1 head)
        string(SUBSTRING ${part} 1 -1 tail)
        string(TOUPPER ${head} head)
        string(APPEND name "${head}${tail}")
    endforeach()
    if(name MATCHES "^[0-9]")
        set(name "N${name}")
    endif()
    set(${output} ${name} PARENT_SCOPE)
endfunction()

function(bright_generate_icons info_json engine_output editor_output)
    file(STRINGS ${info_json} lines)
    set(names "")
    set(enum_entries "")
    set(glyph_entries "")
    set(current "")
    set(minimum 0xFFFF)
    set(maximum 0)
    foreach(line ${lines})
        if(line MATCHES "^  \"([a-z0-9-]+)\": {")
            set(current ${CMAKE_MATCH_1})
        elseif(current AND line MATCHES "\"encodedCode\": \"\\\\\\\\([0-9a-f]+)\"")
            set(code "0x${CMAKE_MATCH_1}")
            bright_icon_name(${current} name)
            set(current "")
            if(name IN_LIST names)
                continue()
            endif()
            list(APPEND names ${name})
            bright_icon_utf8(${code} glyph)
            string(APPEND enum_entries "        ${name},\n")
            string(APPEND glyph_entries "        ${glyph},\n")
            if(code LESS minimum)
                set(minimum ${code})
            endif()
            if(code GREATER maximum)
                set(maximum ${code})
            endif()
        endif()
    endforeach()
    math(EXPR minimum "${minimum}" OUTPUT_FORMAT HEXADECIMAL)
    math(EXPR maximum "${maximum}" OUTPUT_FORMAT HEXADECIMAL)

    set(icon_header "#pragma once\n\n#include <cstdint>\n\nnamespace BrightBox3D::Core\n{\n    enum class Icon : uint16_t\n    {\n        None,\n${enum_entries}        Count\n    };\n}\n")
    file(WRITE ${engine_output}.tmp "${icon_header}")
    configure_file(${engine_output}.tmp ${engine_output} COPYONLY)

    set(glyph_header "#pragma once\n\n#include \"Core/Icon.h\"\n\n#include <cstddef>\n\nnamespace BrightBox3D::Editor\n{\n    using Core::Icon;\n\n    inline constexpr unsigned short IconRangeMin = ${minimum};\n    inline constexpr unsigned short IconRangeMax = ${maximum};\n\n    inline constexpr const char* IconGlyphs[] = {\n        \"\",\n${glyph_entries}    };\n\n    static_assert(sizeof(IconGlyphs) / sizeof(IconGlyphs[0]) == static_cast<size_t>(Core::Icon::Count));\n\n    inline const char* IconGlyph(Core::Icon icon)\n    {\n        return IconGlyphs[static_cast<size_t>(icon)];\n    }\n}\n")
    file(WRITE ${editor_output}.tmp "${glyph_header}")
    configure_file(${editor_output}.tmp ${editor_output} COPYONLY)
endfunction()
