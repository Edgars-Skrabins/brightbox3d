include(${CMAKE_CURRENT_LIST_DIR}/ModuleDependencies.cmake)

set(violations "")
foreach(module ${BRIGHT_MODULES})
    set(allowed ${module} ${BRIGHT_MODULE_DEPENDENCIES_${module}})
    file(GLOB_RECURSE files ${BRIGHT_ENGINE_SOURCE}/${module}/*.h ${BRIGHT_ENGINE_SOURCE}/${module}/*.cpp ${BRIGHT_ENGINE_SOURCE}/${module}/*.mm)
    foreach(file ${files})
        set(lineNumber 0)
        file(STRINGS ${file} allLines)
        foreach(line ${allLines})
            math(EXPR lineNumber "${lineNumber} + 1")
            if(line MATCHES "^[ \t]*#include \"([A-Za-z0-9]+)/")
                set(included ${CMAKE_MATCH_1})
                if(included IN_LIST BRIGHT_MODULES AND NOT included IN_LIST allowed)
                    file(RELATIVE_PATH relative ${BRIGHT_ENGINE_SOURCE} ${file})
                    list(APPEND violations "Module '${module}' may not include '${included}' (${relative}:${lineNumber})")
                endif()
            endif()
        endforeach()
    endforeach()
endforeach()

if(violations)
    list(JOIN violations "\n" message)
    message(FATAL_ERROR "${message}")
endif()
